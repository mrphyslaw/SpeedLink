<UserControl x:Class="SpeedLink.Desktop.LogViewerWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Button x:Name="OpenButton" DockPanel.Dock="Right" Content="Open recording…" Padding="16,9" Click="Open_Click"/><StackPanel><TextBlock Text="Recorded log" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="FileText" Text="Open a SpeedLink log.csv recording" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" Margin="0,5,16,12"/></StackPanel></DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
   <TextBlock Text="Cursor" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider Grid.Column="1" x:Name="TimeCursor" Minimum="0" Maximum="1" ValueChanged="Position_Changed" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="2" Text="Zoom" Margin="18,0,8,0" VerticalAlignment="Center"/><Slider Grid.Column="3" x:Name="Zoom" Minimum="1" Maximum="100" Value="1" ValueChanged="Position_Changed" VerticalAlignment="Center"/>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DockPanel><TextBlock DockPanel.Dock="Bottom" Text="Select up to six channels. Plots share the same time axis. Values keep their recorded units." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
    <DataGrid x:Name="Channels" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" >
     <DataGrid.Columns><DataGridTemplateColumn Header="Plot" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="65"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Plots" SizeChanged="Plots_SizeChanged"/></ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="Summary" Text="No adapter connection is needed." TextWrapping="Wrap"/><TextBlock x:Name="Warnings" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
 </Grid>
</UserControl>
