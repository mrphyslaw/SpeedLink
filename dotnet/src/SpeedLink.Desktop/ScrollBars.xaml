<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="ScrollTrackBrush" Color="#1C2125"/>
 <SolidColorBrush x:Key="ScrollThumbBrush" Color="#71828E"/>
 <SolidColorBrush x:Key="ScrollHoverBrush" Color="#A0B2BF"/>
 <SolidColorBrush x:Key="ScrollGlyphBrush" Color="#CBD4DB"/>
 <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1C2125"/>
 <Style x:Key="ScrollThumb" TargetType="Thumb">
  <Setter Property="Background" Value="{StaticResource ScrollThumbBrush}"/><Setter Property="Focusable" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
   <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3" Margin="3" SnapsToDevicePixels="True"/>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ScrollHoverBrush}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#F2B65D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ScrollArrow" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
   <Border x:Name="Chrome" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#35414A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#493A25"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ScrollPage" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Rectangle Fill="Transparent"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <ControlTemplate x:Key="VerticalScrollTemplate" TargetType="ScrollBar">
  <Border Background="{TemplateBinding Background}" BorderBrush="#434A50" BorderThickness="1,0,0,0" SnapsToDevicePixels="True">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <RepeatButton x:Name="LineDecrease" Height="{x:Static SystemParameters.VerticalScrollBarButtonHeight}" Style="{StaticResource ScrollArrow}" Command="{x:Static ScrollBar.LineUpCommand}" AutomationProperties.Name="Scroll up"><Path Data="M0,3 L3,0 L6,3" Stroke="{StaticResource ScrollGlyphBrush}" StrokeThickness="1.5" Width="6" Height="3" Stretch="Uniform"/></RepeatButton>
    <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True">
     <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinHeight="24"/></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
    </Track>
    <RepeatButton x:Name="LineIncrease" Grid.Row="2" Height="{x:Static SystemParameters.VerticalScrollBarButtonHeight}" Style="{StaticResource ScrollArrow}" Command="{x:Static ScrollBar.LineDownCommand}" AutomationProperties.Name="Scroll down"><Path Data="M0,0 L3,3 L6,0" Stroke="{StaticResource ScrollGlyphBrush}" StrokeThickness="1.5" Width="6" Height="3" Stretch="Uniform"/></RepeatButton>
   </Grid>
  </Border>
 </ControlTemplate>
 <ControlTemplate x:Key="HorizontalScrollTemplate" TargetType="ScrollBar">
  <Border Background="{TemplateBinding Background}" BorderBrush="#434A50" BorderThickness="0,1,0,0" SnapsToDevicePixels="True">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <RepeatButton x:Name="LineDecrease" Width="{x:Static SystemParameters.HorizontalScrollBarButtonWidth}" Style="{StaticResource ScrollArrow}" Command="{x:Static ScrollBar.LineLeftCommand}" AutomationProperties.Name="Scroll left"><Path Data="M3,0 L0,3 L3,6" Stroke="{StaticResource ScrollGlyphBrush}" StrokeThickness="1.5" Width="3" Height="6" Stretch="Uniform"/></RepeatButton>
    <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal" IsDirectionReversed="False">
     <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageLeftCommand}"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinWidth="24"/></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="{x:Static ScrollBar.PageRightCommand}"/></Track.IncreaseRepeatButton>
    </Track>
    <RepeatButton x:Name="LineIncrease" Grid.Column="2" Width="{x:Static SystemParameters.HorizontalScrollBarButtonWidth}" Style="{StaticResource ScrollArrow}" Command="{x:Static ScrollBar.LineRightCommand}" AutomationProperties.Name="Scroll right"><Path Data="M0,0 L3,3 L0,6" Stroke="{StaticResource ScrollGlyphBrush}" StrokeThickness="1.5" Width="3" Height="6" Stretch="Uniform"/></RepeatButton>
   </Grid>
  </Border>
 </ControlTemplate>
 <Style TargetType="ScrollBar">
  <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}"/><Setter Property="Focusable" Value="False"/>
  <Setter Property="Width" Value="{x:Static SystemParameters.VerticalScrollBarWidth}"/>
  <Setter Property="Template" Value="{StaticResource VerticalScrollTemplate}"/>
  <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="{x:Static SystemParameters.HorizontalScrollBarHeight}"/><Setter Property="Template" Value="{StaticResource HorizontalScrollTemplate}"/></Trigger></Style.Triggers>
 </Style>
</ResourceDictionary>
