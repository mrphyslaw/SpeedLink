<Window x:Class="SpeedLink.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SpeedLink.Desktop" Title="SpeedLink" Icon="Assets/SpeedLink.ico" Width="1440" Height="880" MinWidth="980" MinHeight="620" Closing="Window_Closing" Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <Style x:Key="TopSectionNav" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AmberSoftBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AmberBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AmberBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AmberBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SectionTabNav" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AmberBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AmberSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid PreviewKeyDown="Application_KeyDown"><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
  <Border x:Name="ApplicationHeader" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="5,0"><DockPanel>
   <TextBlock DockPanel.Dock="Right" x:Name="SessionText" Text="Offline" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" Margin="8,0,5,0"/>
   <Menu x:Name="ApplicationMenu" Background="Transparent" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" AutomationProperties.Name="Application menu">
    <MenuItem x:Name="ApplicationFileMenu" Header="_File">
     <MenuItem x:Name="ApplicationOpenRomMenu" Header="_Open ROM…" InputGestureText="Ctrl+O" Click="ApplicationOpenRom_Click"/>
     <MenuItem x:Name="ApplicationSaveMenu" Header="_Save ROM copy…" InputGestureText="Ctrl+S" Click="ApplicationSave_Click"/>
     <Separator/><MenuItem x:Name="ApplicationOpenRecordingMenu" Header="Open _recording…" Click="ApplicationOpenRecording_Click"/><MenuItem Header="Open verified _backup…" IsEnabled="{Binding IsEnabled, ElementName=OpenBackupButton}" Click="OpenBackup_Click"/>
     <Separator/><MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="ApplicationExit_Click"/>
    </MenuItem>
    <MenuItem x:Name="ApplicationEditMenu" Header="_Edit"/>
    <MenuItem x:Name="ApplicationViewMenu" Header="_View">
     <MenuItem x:Name="AppearanceMenu" Header="_Appearance">
      <MenuItem Header="_System" Tag="System" IsCheckable="True" Click="Appearance_Click"/>
      <MenuItem Header="_Light" Tag="Light" IsCheckable="True" Click="Appearance_Click"/>
      <MenuItem Header="_Dark" Tag="Dark" IsCheckable="True" Click="Appearance_Click"/>
     </MenuItem>
     <MenuItem Header="Map cell _colors">
      <MenuItem x:Name="RedHighMenu" Header="Green low, red high" Tag="RedHigh" IsCheckable="True" Click="MapColors_Click"/>
      <MenuItem x:Name="GreenHighMenu" Header="Red low, green high" Tag="GreenHigh" IsCheckable="True" Click="MapColors_Click"/>
     </MenuItem>
     <Separator/>
     <MenuItem x:Name="WorkspaceMenu" Header="_Workspace"><MenuItem Header="ECU · _Read backup" Tag="0" InputGestureText="Ctrl+1" Click="WorkspaceMenu_Click"/><MenuItem Header="ECU · _Diagnostics" Tag="7" InputGestureText="Ctrl+8" Click="WorkspaceMenu_Click"/><MenuItem Header="_Flash &amp; Recover" Tag="6" InputGestureText="Ctrl+7" Click="WorkspaceMenu_Click"/><MenuItem Header="_Editor" Tag="1" InputGestureText="Ctrl+2" Click="WorkspaceMenu_Click"/><MenuItem Header="Logging · _Live" Tag="2" InputGestureText="Ctrl+3" Click="WorkspaceMenu_Click"/><MenuItem Header="Logging · _Recordings" Tag="3" InputGestureText="Ctrl+4" Click="WorkspaceMenu_Click"/><MenuItem Header="Editor · ROM _information" Tag="4" InputGestureText="Ctrl+5" Click="WorkspaceMenu_Click"/><MenuItem Header="ECU · Saved _backups" Tag="5" InputGestureText="Ctrl+6" Click="WorkspaceMenu_Click"/></MenuItem>
    </MenuItem>
    <MenuItem x:Name="ApplicationMapViewMenu" Header="_Map"/>
    <MenuItem Header="_Tools"><MenuItem Header="_Engine diagnostics" Tag="7" Click="WorkspaceMenu_Click"/><MenuItem Header="Gen 1 _flashing and recovery…" Click="Gen1Flash_Click"/><Separator/><MenuItem Header="ROM _checks" Tag="4" Click="WorkspaceMenu_Click"/><MenuItem Header="ECU · Saved _backups" Tag="5" Click="WorkspaceMenu_Click"/><Separator/><MenuItem x:Name="DefinitionsButton" Header="_Manage definitions…" Click="Definitions_Click"/><MenuItem x:Name="KeyboardShortcutsMenu" Header="_Keyboard shortcuts…" Click="KeyboardShortcuts_Click"/></MenuItem>
    <MenuItem Header="_Help"><MenuItem Header="_Getting started" Tag="Getting started" Click="ApplicationGuide_Click"/><MenuItem Header="_Navigation and shared connection" Tag="Navigation" Click="ApplicationGuide_Click"/><MenuItem Header="_Editor guide" Tag="Editor" Click="ApplicationGuide_Click"/><MenuItem Header="_Tuning guide" Tag="Tuning guide" Click="ApplicationGuide_Click"/><MenuItem Header="_Logger guide" Tag="Logger" Click="ApplicationGuide_Click"/><MenuItem Header="Gen 1 _flashing guide" Tag="Gen 1 flashing and recovery" Click="ApplicationGuide_Click"/><MenuItem Header="Engine _diagnostics guide" Tag="Engine diagnostics" Click="ApplicationGuide_Click"/><MenuItem Header="_Adapters and testing" Tag="Adapters / testing" Click="ApplicationGuide_Click"/><Separator/><MenuItem Header="Report a _problem" Tag="Report a problem" Click="ApplicationGuide_Click"/><MenuItem Header="Export _support report…" IsEnabled="{Binding IsEnabled, ElementName=ExportReportButton}" Click="ExportReport_Click"/><MenuItem x:Name="CrashReportsButton" Header="_Crash reports…" Click="CrashReports_Click"/><Separator/><MenuItem Header="_About SpeedLink" Click="About_Click"/></MenuItem>
   </Menu>
  </DockPanel></Border>
  <Border Grid.Row="1" x:Name="TopNavigationBar" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource PanelBrush}" Padding="8,5">
   <DockPanel LastChildFill="False">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <ToggleButton x:Name="ConnectionSettingsButton" Style="{DynamicResource ToggleButton}" Content="Adapter · disconnected ▾" MinWidth="190" MaxWidth="280" Padding="10,5" Margin="4,0" ToolTip="Select the shared adapter, COM port, baud or J2534 driver." AutomationProperties.Name="Shared adapter connection settings"/>
     <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" Style="{DynamicResource PrimaryButton}" MinWidth="82" Margin="3,0"/>
     <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click" MinWidth="82" Margin="3,0"/>
    </StackPanel>
    <StackPanel x:Name="Navigation" Orientation="Horizontal">
     <RadioButton Tag="ecu" Content="ECU" AutomationProperties.Name="ECU" ToolTip="Diagnostics, ECU identity, verified reading and saved backups." Padding="14,6" Style="{DynamicResource TopSectionNav}" GroupName="Workspace" Checked="Section_Checked"/>
     <RadioButton Tag="editor" Content="Editor" AutomationProperties.Name="Editor" ToolTip="Maps, named workspaces, ROM information and integrity checks." Padding="14,6" Style="{DynamicResource TopSectionNav}" GroupName="Workspace" Checked="Section_Checked"/>
     <RadioButton Tag="logging" Content="Logging" AutomationProperties.Name="Logging" ToolTip="Live ECU logging and review of saved recordings." Padding="14,6" Style="{DynamicResource TopSectionNav}" GroupName="Workspace" Checked="Section_Checked"/>
     <RadioButton Tag="flash" Content="Flash &amp; Recovery" AutomationProperties.Name="Flash and Recovery" ToolTip="Gen 1 ROM writing, recovery state checks and interrupted-write recovery." Padding="14,6" Style="{DynamicResource TopSectionNav}" GroupName="Workspace" Checked="Section_Checked"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Popup x:Name="SharedConnectionPopup" PlacementTarget="{Binding ElementName=ConnectionSettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=ConnectionSettingsButton, Mode=TwoWay}">
   <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="14" Width="390">
    <StackPanel><TextBlock Text="Shared adapter connection" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="Adapter" Margin="0,0,0,4"/>
     <ComboBox x:Name="AdapterBox" Margin="0,0,0,10" VerticalContentAlignment="Center" SelectionChanged="Adapter_Changed"/>
     <StackPanel x:Name="SerialPanel">
      <DockPanel Margin="0,0,0,7"><TextBlock Text="COM port" Width="85" VerticalAlignment="Center"/><ComboBox x:Name="PortBox" IsEditable="True" VerticalContentAlignment="Center"/></DockPanel>
      <DockPanel Margin="0,0,0,7"><TextBlock Text="Baud" Width="85" VerticalAlignment="Center"/><ComboBox x:Name="BaudBox" VerticalContentAlignment="Center"/></DockPanel>
     </StackPanel>
     <StackPanel x:Name="TactrixPanel" Visibility="Collapsed"><TextBlock Text="J2534 driver" Margin="0,0,0,4"/><ComboBox x:Name="DriverBox" Margin="0,0,0,7" VerticalContentAlignment="Center"/></StackPanel>
     <TextBlock x:Name="AdapterNote" Visibility="Collapsed" Text="Mongoose support is experimental. This adapter supports experimental reading, logging and Gen 1 programming. Physical programming qualification is pending." TextWrapping="Wrap" Foreground="{DynamicResource AmberBrush}" Margin="0,0,0,8"/>
     <Button x:Name="RefreshPortsButton" Content="Refresh devices" Click="RefreshPorts_Click" HorizontalAlignment="Left"/>
     <TextBlock Text="This adapter selection is shared by all four sections." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
    </StackPanel>
   </Border>
  </Popup>
  <Border Grid.Row="2" x:Name="SectionBar" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,4">
   <DockPanel LastChildFill="False">
    <StackPanel x:Name="ActivityPanel" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
     <TextBlock x:Name="SharedActivityText" Text="{Binding Text, ElementName=StatusText}" MaxWidth="390" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=StatusText}" VerticalAlignment="Center" Margin="8,0"/>
     <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" Padding="8,3"/>
    </StackPanel>
    <StackPanel x:Name="SectionTabs" Orientation="Horizontal"/>
   </DockPanel>
  </Border>
   <TabControl Grid.Row="3" x:Name="Pages" Style="{DynamicResource WorkspacePages}" SelectionChanged="Pages_Changed">
<TabItem Header="Connection"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Read and verify an ECU backup" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Use the shared adapter controls above. Keep ignition on and the engine stopped when reading." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,12"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,14"><TextBlock Text="Read protocol" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ReadFamilyBox" Width="260" VerticalContentAlignment="Center" ToolTip="Known ROMs choose their protocol automatically. Choose the ECU generation for an unknown ROM."/>
         <Button x:Name="ReadButton" Content="Read &amp; verify backup" Click="Read_Click" ToolTipService.ShowOnDisabled="True"/>
     <Button x:Name="FlashBackupButton" Content="Open in Flash &amp; Recovery" Visibility="Collapsed" Click="OpenBackupInFlash_Click" ToolTip="Carry this verified backup to the Gen 1 flashing workspace."/><Button x:Name="ExportReportButton"  Content="Export support report…" Click="ExportReport_Click"/></WrapPanel>
    <TextBlock Grid.Row="3" x:Name="IdentityText" Text="Disconnected. No ECU has been identified." TextWrapping="Wrap" Margin="0,10,0,10"/>
    <Border x:Name="ReadProgressPanel" Grid.Row="4" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
     <StackPanel>
      <DockPanel Margin="0,0,0,8"><TextBlock x:Name="ReadProgressPercent" DockPanel.Dock="Right" Text="0% overall" Foreground="{DynamicResource AmberBrush}" FontWeight="SemiBold" Margin="12,0,0,0"/><TextBlock x:Name="ReadProgressStage" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
      <ProgressBar x:Name="ReadBackupBar" Height="12" Minimum="0" Maximum="100" Foreground="{DynamicResource AmberBrush}" Background="{DynamicResource RaisedBrush}" AutomationProperties.Name="Overall ROM backup progress" Margin="0,0,0,8">
       <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="1"><Grid x:Name="PART_Track" ClipToBounds="True"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/></Grid></Border></ControlTemplate></ProgressBar.Template>
      </ProgressBar>
      <TextBlock x:Name="ReadProgressDetail" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
      <TextBlock x:Name="ReadProgressTiming" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
     </StackPanel>
    </Border>
    <StackPanel Grid.Row="5" Margin="0,0,0,10"><TextBlock x:Name="DiagnosticStatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/><TextBlock Text="Two matching 1 MiB reads are required. Original captures, identity, SHA-256 hashes and the journal are retained." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
    <TextBox Grid.Row="6" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
   </Grid></TabItem>
<TabItem Header="Editor"><local:EditorWorkspace x:Name="EditorPane"/></TabItem>
<TabItem Header="Logger"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>    <StackPanel><TextBlock x:Name="LoggerProfileText" Text="Load the current ROM to select a logger profile" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,8"/><WrapPanel><TextBlock x:Name="LoggerConnectionHint" Visibility="Collapsed" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="640" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/><Button x:Name="LoggerConnectionButton" Visibility="Collapsed" Content="Adapter settings…" Click="LoggerConnection_Click"/></WrapPanel></StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,6"><Button x:Name="LoggerRomButton" Content="Load current ECU ROM…" Click="LoggerRom_Click"/><TextBlock x:Name="LoggerRomText" Text="Load a matching backup to use its MAP calibration." TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
    <WrapPanel Grid.Row="2" Margin="0,0,0,6">
     <Button x:Name="LoggerStartButton" Content="Start logging" Click="LoggerStart_Click" ToolTipService.ShowOnDisabled="True" Style="{DynamicResource PrimaryButton}"/>
     <Button x:Name="LoggerStopButton" Content="Stop" Click="Stop_Click"/>
     <CheckBox x:Name="RecordCsvBox" Content="Record CSV" IsChecked="True" VerticalAlignment="Center" Margin="8,0,16,0"/>
     <TextBlock Text="Polling" VerticalAlignment="Center"/><ComboBox x:Name="LoggerRateBox" ToolTip="Max polls as quickly as complete replies allow. An optional scans/s limit reduces bus traffic and recording volume." Width="65" Margin="8,0,16,0" VerticalContentAlignment="Center"/>
     <TextBlock Text="Stoich AFR" VerticalAlignment="Center"/><TextBox x:Name="StoichBox" Width="65" Margin="8,0,0,0" ToolTip="Optional. Enter your fuel's stoichiometric AFR before choosing AFR units. Leave blank to use lambda."/>
    </WrapPanel>
    <DockPanel Grid.Row="3" Margin="0,0,0,6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="LoggerEssentialsButton" Content="Essentials" Click="LoggerEssentials_Click"/><Button x:Name="LoggerAllButton" Content="All" Click="LoggerAll_Click"/><Button x:Name="LoggerNoneButton" Content="None" Click="LoggerNone_Click"/></StackPanel><TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="LoggerSearchBox" TextChanged="LoggerSearch_Changed" ToolTip="Filter by parameter name or group" Margin="0,0,12,0"/></DockPanel>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="400"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>    <DataGrid Grid.Column="0" x:Name="LoggerGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="LoggerSelection_Changed" HeadersVisibility="Column" EnableRowVirtualization="True">
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="Plot" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Plotted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Log" Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsEnabled="{Binding CanEdit}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Group" Binding="{Binding Group}" IsReadOnly="True" Width="75"/>
      <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="150"/>
      <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" IsReadOnly="True" Width="90"/>
      <DataGridTemplateColumn Header="Unit" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Hz" Binding="{Binding RateText}" IsReadOnly="True" Width="55"/>
      <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="130"/>
     </DataGrid.Columns>
    </DataGrid><GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="{DynamicResource ShellBrush}"/><ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="LoggerPlots" SizeChanged="LoggerChart_SizeChanged"/></ScrollViewer></Grid>    <StackPanel Grid.Row="5" Margin="0,8,0,0"><TextBlock x:Name="LoggerHelpText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/><DockPanel Margin="0,6,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ViewRecordingButton" Content="View recording…" Click="ViewRecording_Click"/><Button Content="Open logs" Click="OpenLogs_Click"/></StackPanel><StackPanel><TextBlock x:Name="LoggerRateText" Text="Rates are measured during logging. More selected parameters reduce each channel's rate." TextTrimming="CharacterEllipsis"/><TextBlock x:Name="LoggerFileText" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DockPanel></StackPanel>
</Grid></TabItem>
<TabItem Header="Recordings"><local:LogViewerWorkspace x:Name="RecordingsPane"/></TabItem>
<TabItem Header="ROM information"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="ROM information and integrity" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Known ROMs can be identified and checked. Unknown ROMs can still be read and saved." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,18"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal"><Button Content="Launch ROM editor…" Click="Editor_Click" Style="{DynamicResource PrimaryButton}"/><Button x:Name="OpenRomButton" Content="Inspect ROM…" Click="OpenRom_Click"/><Button x:Name="CorrectButton" Content="Save checksum-corrected copy…" Click="Correct_Click"/><Button x:Name="OpenBackupButton" Content="Open verified backup…" Click="OpenBackup_Click"/></StackPanel>
    <TextBlock Grid.Row="2" x:Name="BackupText" Text="Verified backup: none selected" TextWrapping="Wrap" Margin="0,14,0,8"/>
    <TextBox Grid.Row="3" x:Name="RomText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
   </Grid></TabItem>
<TabItem Header="Backups"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Saved operations" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Interrupted operations are retained for inspection. Reconnect and begin a new read." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,18"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><Button x:Name="RefreshHistoryButton" Content="Refresh" Click="RefreshHistory_Click"/><Button Content="Open backup folder" Click="OpenFolder_Click"/></StackPanel>
    <DataGrid Grid.Row="2" x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
     <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="90"/><DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="150"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170"/><DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*"/>
    </DataGrid.Columns></DataGrid><TextBlock Grid.Row="3" x:Name="HistoryNote" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
   </Grid></TabItem>
    <TabItem x:Name="FlashTab" Header="Flash &amp; Recover"/>
    <TabItem x:Name="ObdTab" Header="Diagnostics"/>
   </TabControl>
  <Border Grid.Row="4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,3"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="4"/></Grid.RowDefinitions><TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" Text="Ready · select your adapter" TextTrimming="CharacterEllipsis"/><ProgressBar Grid.Row="1" x:Name="ProgressBar" Height="3" Foreground="{DynamicResource AmberBrush}" Background="{DynamicResource RaisedBrush}" BorderThickness="0" Minimum="0" Maximum="100"/></Grid></Border>
 </Grid>
</Window>
