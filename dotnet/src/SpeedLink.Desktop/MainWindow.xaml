<Window x:Class="SpeedLink.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SpeedLink.Desktop" Title="SpeedLink" Width="1440" Height="880" MinWidth="980" MinHeight="620" Closing="Window_Closing" Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid PreviewKeyDown="Application_KeyDown"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
  <Border x:Name="ApplicationHeader" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,2"><DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,0,18,0"/><TextBlock x:Name="SessionText" Text="Offline" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220"/></StackPanel>
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="SL" FontStyle="Italic" Foreground="{DynamicResource AmberBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,8,0"/><TextBlock Text="SpeedLink" FontSize="16" FontWeight="SemiBold"/></StackPanel>
   <Menu x:Name="ApplicationMenu" Background="Transparent" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" AutomationProperties.Name="Application menu">
    <MenuItem x:Name="ApplicationFileMenu" Header="_File">
     <MenuItem Header="_Open ROM…" InputGestureText="Ctrl+O" Click="ApplicationOpenRom_Click"/>
     <MenuItem x:Name="ApplicationSaveMenu" Header="_Save ROM copy…" InputGestureText="Ctrl+S" Click="ApplicationSave_Click"/>
     <Separator/><MenuItem Header="Open _recording…" Click="ApplicationOpenRecording_Click"/><MenuItem Header="Open verified _backup…" IsEnabled="{Binding IsEnabled, ElementName=OpenBackupButton}" Click="OpenBackup_Click"/>
     <Separator/><MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="ApplicationExit_Click"/>
    </MenuItem>
    <MenuItem x:Name="ApplicationEditMenu" Header="_Edit"/>
    <MenuItem x:Name="ApplicationViewMenu" Header="_View">
     <MenuItem x:Name="NavigationLabelsMenu" Header="Navigation _labels" IsCheckable="True" IsChecked="True" Click="NavigationLabels_Click"/>
     <Separator/>
     <MenuItem x:Name="WorkspaceMenu" Header="_Workspace"><MenuItem Header="_Connection" Tag="0" InputGestureText="Ctrl+1" Click="WorkspaceMenu_Click"/><MenuItem Header="_Editor" Tag="1" InputGestureText="Ctrl+2" Click="WorkspaceMenu_Click"/><MenuItem Header="_Logger" Tag="2" InputGestureText="Ctrl+3" Click="WorkspaceMenu_Click"/><MenuItem Header="_Recordings" Tag="3" InputGestureText="Ctrl+4" Click="WorkspaceMenu_Click"/><MenuItem Header="ROM c_hecks" Tag="4" InputGestureText="Ctrl+5" Click="WorkspaceMenu_Click"/><MenuItem Header="_Backups" Tag="5" InputGestureText="Ctrl+6" Click="WorkspaceMenu_Click"/></MenuItem>
     <Separator/><MenuItem x:Name="ApplicationMapViewMenu" Header="_Map layout and display"/>
    </MenuItem>
    <MenuItem Header="_Tools"><MenuItem Header="ROM _checks" Tag="4" Click="WorkspaceMenu_Click"/><MenuItem Header="_Backups" Tag="5" Click="WorkspaceMenu_Click"/><Separator/><MenuItem x:Name="DefinitionsButton" Header="_Manage definitions…" Click="Definitions_Click"/></MenuItem>
    <MenuItem Header="_Help"><MenuItem Header="_Getting started" Tag="Getting started" Click="ApplicationGuide_Click"/><MenuItem Header="_Editor guide" Tag="Editor" Click="ApplicationGuide_Click"/><MenuItem Header="_Logger guide" Tag="Logger" Click="ApplicationGuide_Click"/><MenuItem Header="_Adapters and testing" Tag="Adapters / testing" Click="ApplicationGuide_Click"/><Separator/><MenuItem Header="Report a _problem" Tag="Report a problem" Click="ApplicationGuide_Click"/><MenuItem Header="Export _support report…" IsEnabled="{Binding IsEnabled, ElementName=ExportReportButton}" Click="ExportReport_Click"/><MenuItem x:Name="CrashReportsButton" Header="_Crash reports…" Click="CrashReports_Click"/><Separator/><MenuItem Header="_About SpeedLink" Click="About_Click"/></MenuItem>
   </Menu>
  </DockPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="4,6"><DockPanel><Button x:Name="NavigationToggle" DockPanel.Dock="Top" Content="☰" ToolTip="Collapse navigation" Click="NavigationToggle_Click" Padding="5,3" MinHeight="27" Margin="0,0,0,8"/><StackPanel x:Name="Navigation"><RadioButton Tag="0" AutomationProperties.Name="Connection" ToolTip="Connect an adapter, identify the ECU, and read a verified backup." Padding="6,9" Style="{DynamicResource WorkspaceNav}" GroupName="Workspace" Checked="Navigate_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="↔" FontSize="18" Width="24" TextAlignment="Center"/><TextBlock x:Name="NavLabel0" Text="Connection" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Tag="1" AutomationProperties.Name="Editor" ToolTip="Browse maps, edit a ROM, and save a verified copy." Padding="6,9" Style="{DynamicResource WorkspaceNav}" GroupName="Workspace" Checked="Navigate_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="18" Width="24" TextAlignment="Center"/><TextBlock x:Name="NavLabel1" Text="Editor" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Tag="2" AutomationProperties.Name="Logger" ToolTip="View live ECU data and record a log." Padding="6,9" Style="{DynamicResource WorkspaceNav}" GroupName="Workspace" Checked="Navigate_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="⌁" FontSize="18" Width="24" TextAlignment="Center"/><TextBlock x:Name="NavLabel2" Text="Logger" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Tag="3" AutomationProperties.Name="Recordings" ToolTip="Open and review saved logs." Padding="6,9" Style="{DynamicResource WorkspaceNav}" GroupName="Workspace" Checked="Navigate_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="≋" FontSize="18" Width="24" TextAlignment="Center"/><TextBlock x:Name="NavLabel3" Text="Recordings" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></RadioButton><Separator Margin="5,10"/><RadioButton Tag="4" AutomationProperties.Name="ROM checks" ToolTip="Identify a ROM and verify its integrity." Padding="6,9" Style="{DynamicResource WorkspaceNav}" GroupName="Workspace" Checked="Navigate_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontSize="18" Width="24" TextAlignment="Center"/><TextBlock x:Name="NavLabel4" Text="ROM checks" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></RadioButton><RadioButton Tag="5" AutomationProperties.Name="Backups" ToolTip="Find saved backups and inspect interrupted reads." Padding="6,9" Style="{DynamicResource WorkspaceNav}" GroupName="Workspace" Checked="Navigate_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="18" Width="24" TextAlignment="Center"/><TextBlock x:Name="NavLabel5" Text="Backups" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></RadioButton></StackPanel></DockPanel></Border>
   <TabControl Grid.Column="1" x:Name="Pages" Style="{DynamicResource WorkspacePages}" SelectionChanged="Pages_Changed">
<TabItem Header="Connection"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Connect, identify, back up" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Select your adapter. Keep the ignition on and engine stopped when reading." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,18"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,14" VerticalAlignment="Center">
     <ComboBox x:Name="AdapterBox" Width="310" Margin="0,0,16,0" VerticalContentAlignment="Center" SelectionChanged="Adapter_Changed"/>
     <StackPanel x:Name="SerialPanel" Orientation="Horizontal"><TextBlock Text="COM port" Margin="0,8,8,0"/>
     <ComboBox x:Name="PortBox" Width="100" IsEditable="True" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
     <TextBlock Text="Baud" Margin="12,8,8,0"/><ComboBox x:Name="BaudBox" Width="110" VerticalContentAlignment="Center"/>
     </StackPanel>
     <StackPanel x:Name="TactrixPanel" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="Driver" Margin="0,8,8,0"/><ComboBox x:Name="DriverBox" Width="360" VerticalContentAlignment="Center"/></StackPanel>
     <Button x:Name="RefreshPortsButton" Content="Refresh devices" Click="RefreshPorts_Click" Margin="12,0,0,0"/>
     <ComboBox x:Name="ReadFamilyBox" Width="215" Margin="12,0,0,0" VerticalContentAlignment="Center" ToolTip="Known ROMs select their protocol automatically. For an unknown ROM, choose its ECU generation before reading."/>
    </WrapPanel>
    <DockPanel Grid.Row="2" LastChildFill="False"><Button x:Name="ConnectButton" Content="Connect &amp; identify" Click="Connect_Click" Style="{DynamicResource PrimaryButton}"/>
     <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click"/><Button x:Name="ReadButton" Content="Read &amp; verify backup" Click="Read_Click"/>
     <Button x:Name="ExportReportButton" DockPanel.Dock="Right" Content="Export support report…" Click="ExportReport_Click"/><Button x:Name="StopButton" DockPanel.Dock="Right" Content="Stop" Click="Stop_Click"/></DockPanel>
    <TextBlock Grid.Row="3" x:Name="IdentityText" Text="Disconnected. No ECU has been identified." TextWrapping="Wrap" Margin="0,18,0,12"/>
    <Border x:Name="ReadProgressPanel" Grid.Row="4" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
     <StackPanel>
      <DockPanel Margin="0,0,0,8"><TextBlock x:Name="ReadProgressPercent" DockPanel.Dock="Right" Text="0% overall" Foreground="{DynamicResource AmberBrush}" FontWeight="SemiBold" Margin="12,0,0,0"/><TextBlock x:Name="ReadProgressStage" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
      <ProgressBar x:Name="ReadBackupBar" Height="12" Minimum="0" Maximum="100" Foreground="{DynamicResource AmberBrush}" Background="{DynamicResource RaisedBrush}" AutomationProperties.Name="Overall ROM backup progress" Margin="0,0,0,8">
       <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="1"><Grid x:Name="PART_Track" ClipToBounds="True"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/></Grid></Border></ControlTemplate></ProgressBar.Template>
      </ProgressBar>
      <TextBlock x:Name="ReadProgressDetail" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
      <TextBlock x:Name="ReadProgressTiming" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
     </StackPanel>
    </Border>
    <StackPanel Grid.Row="5" Margin="0,0,0,10"><TextBlock x:Name="DiagnosticStatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/><TextBlock x:Name="AdapterNote" Visibility="Collapsed" Text="Mongoose support is experimental. Reading and logging need hardware testing; flashing is disabled." TextWrapping="Wrap" Foreground="{DynamicResource AmberBrush}" Margin="0,0,0,8"/><TextBlock Text="Two matching 1 MiB reads are required. Original captures, identity, SHA-256 hashes and the journal are retained." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
    <TextBox Grid.Row="6" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
   </Grid></TabItem>
<TabItem Header="Editor"><local:EditorWorkspace x:Name="EditorPane"/></TabItem>
<TabItem Header="Logger"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>    <StackPanel><TextBlock Text="Live data &amp; recording" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="LoggerProfileText" Text="Load the current ROM to select a logger profile" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,12"/><WrapPanel><TextBlock x:Name="LoggerConnectionHint" Visibility="Collapsed" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="640" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/><Button x:Name="LoggerConnectionButton" Visibility="Collapsed" Content="Go to Connection" Click="LoggerConnection_Click"/></WrapPanel></StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,10"><Button x:Name="LoggerRomButton" Content="Load current ECU ROM…" Click="LoggerRom_Click"/><TextBlock x:Name="LoggerRomText" Text="Load a matching backup to use its MAP calibration." TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
     <Button x:Name="LoggerStartButton" Content="Start logging" Click="LoggerStart_Click" ToolTipService.ShowOnDisabled="True" Style="{DynamicResource PrimaryButton}"/>
     <Button x:Name="LoggerStopButton" Content="Stop" Click="Stop_Click"/>
     <CheckBox x:Name="RecordCsvBox" Content="Record CSV" IsChecked="True" VerticalAlignment="Center" Margin="8,0,16,0"/>
     <TextBlock Text="Target scans/s" VerticalAlignment="Center"/><ComboBox x:Name="LoggerRateBox" Width="65" Margin="8,0,16,0" VerticalContentAlignment="Center"/>
     <TextBlock Text="Stoich AFR" VerticalAlignment="Center"/><TextBox x:Name="StoichBox" Width="65" Margin="8,0,0,0" ToolTip="Optional. Enter your fuel's stoichiometric AFR before choosing AFR units. Leave blank to use lambda."/>
    </WrapPanel>
    <DockPanel Grid.Row="3" Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="LoggerEssentialsButton" Content="Essentials" Click="LoggerEssentials_Click"/><Button x:Name="LoggerAllButton" Content="All" Click="LoggerAll_Click"/><Button x:Name="LoggerNoneButton" Content="None" Click="LoggerNone_Click"/></StackPanel><TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="LoggerSearchBox" TextChanged="LoggerSearch_Changed" ToolTip="Filter by parameter name or group" Margin="0,0,12,0"/></DockPanel>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="400"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>    <DataGrid Grid.Column="0" x:Name="LoggerGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="LoggerSelection_Changed" HeadersVisibility="Column" EnableRowVirtualization="True">
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="Plot" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Plotted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Log" Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsEnabled="{Binding CanEdit}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Group" Binding="{Binding Group}" IsReadOnly="True" Width="75"/>
      <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="150"/>
      <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" IsReadOnly="True" Width="90"/>
      <DataGridTemplateColumn Header="Unit" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Hz" Binding="{Binding RateText}" IsReadOnly="True" Width="55"/>
      <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="130"/>
     </DataGrid.Columns>
    </DataGrid><GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="{DynamicResource ShellBrush}"/><ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="LoggerPlots" SizeChanged="LoggerChart_SizeChanged"/></ScrollViewer></Grid>    <StackPanel Grid.Row="5" Margin="0,8,0,0"><TextBlock x:Name="LoggerHelpText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/><DockPanel Margin="0,6,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="View recording…" Click="ViewRecording_Click"/><Button Content="Open logs" Click="OpenLogs_Click"/></StackPanel><StackPanel><TextBlock x:Name="LoggerRateText" Text="Rates are measured during logging. More selected parameters reduce each channel's rate." TextTrimming="CharacterEllipsis"/><TextBlock x:Name="LoggerFileText" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DockPanel></StackPanel>
</Grid></TabItem>
<TabItem Header="Recordings"><local:LogViewerWorkspace x:Name="RecordingsPane"/></TabItem>
<TabItem Header="ROM checks"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Inspect the image" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Known ROMs can be identified and checked. Unknown ROMs can still be read and saved." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,18"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal"><Button Content="Launch ROM editor…" Click="Editor_Click" Style="{DynamicResource PrimaryButton}"/><Button x:Name="OpenRomButton" Content="Inspect ROM…" Click="OpenRom_Click"/><Button x:Name="CorrectButton" Content="Save checksum-corrected copy…" Click="Correct_Click"/><Button x:Name="OpenBackupButton" Content="Open verified backup…" Click="OpenBackup_Click"/></StackPanel>
    <TextBlock Grid.Row="2" x:Name="BackupText" Text="Verified backup: none selected" TextWrapping="Wrap" Margin="0,14,0,8"/>
    <TextBox Grid.Row="3" x:Name="RomText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
   </Grid></TabItem>
<TabItem Header="Backups"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Saved operations" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Interrupted operations are retained for inspection. Reconnect and begin a new read." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,18"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><Button x:Name="RefreshHistoryButton" Content="Refresh" Click="RefreshHistory_Click"/><Button Content="Open backup folder" Click="OpenFolder_Click"/></StackPanel>
    <DataGrid Grid.Row="2" x:Name="HistoryGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
     <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="90"/><DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="150"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170"/><DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*"/>
    </DataGrid.Columns></DataGrid><TextBlock Grid.Row="3" x:Name="HistoryNote" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
   </Grid></TabItem>
   </TabControl></Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,3"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="4"/></Grid.RowDefinitions><TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" Text="Ready · select your adapter" TextTrimming="CharacterEllipsis"/><ProgressBar Grid.Row="1" x:Name="ProgressBar" Height="3" Foreground="{DynamicResource AmberBrush}" Background="{DynamicResource RaisedBrush}" BorderThickness="0" Minimum="0" Maximum="100"/></Grid></Border>
 </Grid>
</Window>
