<UserControl x:Class="SpeedLink.Desktop.EditorWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SpeedLink.Desktop" PreviewKeyDown="Editor_KeyDown" Background="{DynamicResource ShellBrush}" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <DataTemplate x:Key="MapBrowserHeader">
   <StackPanel Orientation="Horizontal">
    <Path Data="{Binding Icon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" Stretch="Uniform"
          Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="NamedMapRowHeader">
   <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}"/>
  </DataTemplate>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="5,2"/></Style>
 </UserControl.Resources>
 <Grid x:Name="WorkspaceRoot" Margin="8"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
  <DockPanel x:Name="EditorToolbar">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SaveButton" Content="Save copy…" Click="Save_Click" Style="{DynamicResource PrimaryButton}" Padding="10,3" MinHeight="26"/><Button x:Name="FitMapButton" Content="Fit map" Click="FitMap_Click" ToolTip="Show the complete table · Ctrl+0"/></StackPanel>
   <Menu x:Name="EditorMenu" DockPanel.Dock="Left" Background="Transparent" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center">
    <MenuItem Header="_File"><MenuItem x:Name="EditorOpenMenu" Header="Open ROM…" InputGestureText="Ctrl+O" Click="Open_Click"/><MenuItem x:Name="EditorSaveMenu" Header="Save a new copy…" InputGestureText="Ctrl+S" IsEnabled="{Binding IsEnabled, ElementName=SaveButton}" Click="Save_Click"/><Separator/><MenuItem Header="Editor guide" Click="Guide_Click"/></MenuItem>
    <MenuItem Header="_Edit"><MenuItem x:Name="CopyMenu" Header="Copy" InputGestureText="Ctrl+C" Click="Copy_Click"/><MenuItem x:Name="PasteMenu" Header="Paste" InputGestureText="Ctrl+V" Click="Paste_Click"/><MenuItem x:Name="ResetCellsMenu" Header="Reset selection to baseline" Click="Reset_Click"/><Separator/><MenuItem x:Name="CompareButton" Header="Compare ROM…" Click="Compare_Click"/></MenuItem>
    <MenuItem Header="_View"><MenuItem Header="Tile maps side by side" Tag="2" Click="ArrangeMaps_Click"/><MenuItem Header="Stack maps vertically" Tag="1" Click="ArrangeMaps_Click"/><Separator/><MenuItem x:Name="FitEntireMapMenu" Header="Fit entire map" InputGestureText="Ctrl+0" Click="FitMap_Click"/><Separator/><MenuItem x:Name="PreviewItem" Header="Table with 3D preview" Tag="4" IsCheckable="True" Click="ViewMenu_Click"/><MenuItem x:Name="BelowItem" Header="Table above graph" Tag="0" IsCheckable="True" Click="ViewMenu_Click"/><MenuItem x:Name="BesideItem" Header="Table beside graph" Tag="1" IsCheckable="True" Click="ViewMenu_Click"/><MenuItem x:Name="TableItem" Header="Table only" Tag="2" IsCheckable="True" Click="ViewMenu_Click"/><MenuItem x:Name="GraphItem" Header="Graph only" Tag="3" IsCheckable="True" Click="ViewMenu_Click"/><MenuItem x:Name="ToggleGraphItem" Header="Toggle table and graph" InputGestureText="F4" Click="ToggleGraph_Click"/><Separator/><MenuItem x:Name="CloseOtherMapsItem" Header="Close other maps" Click="CloseOtherMaps_Click"/><Separator/><MenuItem x:Name="FocusButton" Header="Hide map browser" InputGestureText="Ctrl+B" IsCheckable="True" Checked="Layout_Changed" Unchecked="Layout_Changed"/><MenuItem Header="Pop out map browser" Click="PopBrowser_Click"/><MenuItem Header="Dock map browser" Click="DockBrowser_Click"/><MenuItem Header="Pop out graph" Click="PopGraph_Click"/><MenuItem Header="Dock graph" Click="DockGraph_Click"/><Separator/><MenuItem x:Name="DetailsButton" Header="Map information…" InputGestureText="F1" Click="MenuMapInfo_Click" Checked="Layout_Changed" Unchecked="Layout_Changed"/><MenuItem x:Name="ChangesButton" Header="Changes (0)" IsCheckable="True" Checked="Layout_Changed" Unchecked="Layout_Changed"/></MenuItem>
   </Menu>
   <Button x:Name="MapsButton" DockPanel.Dock="Left" Content="Maps" Click="ShowBrowser_Click" ToolTip="Show the map browser · Ctrl+B toggles visibility" AutomationProperties.Name="Show map browser" Margin="6,0,0,0"/>
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="6,0"><Button x:Name="UndoButton" Content="↶" Click="Undo_Click" ToolTip="Undo · Ctrl+Z" Width="28"/><Button x:Name="RedoButton" Content="↷" Click="Redo_Click" ToolTip="Redo · Ctrl+Y" Width="28"/></StackPanel>
   <TextBlock x:Name="ProfileText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="5,0"/>
  </DockPanel>
  <ScrollViewer Grid.Row="1" x:Name="WorkspaceTabsBar" Visibility="Collapsed" Margin="0,0,0,5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
   <StackPanel Orientation="Horizontal">
    <TabControl x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTab_Changed" AutomationProperties.Name="Map workspace tabs">
     <TabControl.Template><ControlTemplate TargetType="TabControl"><TabPanel IsItemsHost="True"/></ControlTemplate></TabControl.Template>
    </TabControl>
    <Button x:Name="NewWorkspaceButton" Content="+" Click="NewWorkspace_Click" Width="26" MinHeight="24" FontSize="16" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="New map workspace tab" ToolTip="Create an empty workspace tab"/>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" x:Name="EditorLayout"><Grid.ColumnDefinitions><ColumnDefinition x:Name="BrowserColumn" Width="200" MinWidth="0"/><ColumnDefinition x:Name="BrowserDivider" Width="5"/><ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition x:Name="ChangesDivider" Width="0"/><ColumnDefinition x:Name="ChangesColumn" Width="0"/></Grid.ColumnDefinitions>
   <Border x:Name="BrowserPanel" Background="{DynamicResource PanelBrush}" Padding="6"><DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="↗" Click="PopBrowser_Click" ToolTip="Pop out map browser" Padding="5,0" MinHeight="23"/><Button Content="×" Click="HideBrowser_Click" ToolTip="Hide map browser" Padding="5,0" MinHeight="23"/></StackPanel><TextBlock Text="Maps" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" ToolTip="Search maps" TextChanged="Search_Changed" Margin="0,0,0,5" Padding="5,3"/>
    <CheckBox x:Name="ChangedOnly" DockPanel.Dock="Top" Content="Changed maps only" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,3,0,5"/>
    <TextBlock x:Name="MapCountText" DockPanel.Dock="Bottom" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
    <TreeView x:Name="MapTree" SelectedItemChanged="Map_Selected" RequestBringIntoView="PreserveBrowserScroll" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
   </DockPanel></Border>
   <GridSplitter x:Name="BrowserSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource ShellBrush}" DragCompleted="LayoutSplitter_Completed"/>
   <Grid Grid.Column="2" x:Name="MapWorkspace"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,2,0,3">
       <ToggleButton x:Name="PinMapButton" Content="Pin" Click="PinMap_Click" Style="{DynamicResource ToggleButton}" Padding="5,1" MinHeight="23" Margin="0,0,4,0" ToolTipService.ShowOnDisabled="True"/>
       <Button x:Name="CloseMapButton" Content="×" Click="CloseMap_Click" Width="23" MinHeight="23" Padding="0" ToolTip="Close this map view; keep its ROM edits" AutomationProperties.Name="Close map"/>
      </StackPanel>
      <Grid x:Name="PaneDragArea" Background="Transparent" Cursor="SizeAll" Focusable="True" AutomationProperties.Name="{Binding Text, ElementName=PaneCaption}">
       <TextBlock x:Name="PaneCaption" Margin="2,2,0,3" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TabControl x:Name="MapTabs" SelectionChanged="Tab_Changed" Visibility="Collapsed"/>
      </Grid>
     </DockPanel>
    </StackPanel>
    <WrapPanel x:Name="EditBar" Grid.Row="1" Margin="3,1"><ComboBox x:Name="ChoiceBox" Width="220" Visibility="Collapsed" SelectionChanged="Choice_Changed"/>
     <TextBox x:Name="OperandBox" Text="1" Width="52" Padding="5,2" Margin="0,0,4,0" ToolTip="Amount"/><Button x:Name="SetMapButton" Content="Set" Click="Set_Click"/><Button x:Name="AddMapButton" Content="Add" Click="Add_Click"/><Button x:Name="MultiplyMapButton" Content="×" Click="Multiply_Click" ToolTip="Multiply"/><ComboBox x:Name="InterpolationBox" Width="88" SelectedIndex="0"><ComboBoxItem Content="Horizontal"/><ComboBoxItem Content="Vertical"/><ComboBoxItem Content="2D"/></ComboBox><Button x:Name="InterpolateMapButton" Content="Interpolate" Click="Interpolate_Click" Margin="4,0,0,0"/>
     <ComboBox x:Name="BaselineBox" Visibility="Collapsed" SelectionChanged="Baseline_Changed"/>
    </WrapPanel>
    <Grid Grid.Row="2" x:Name="DataLayout" SizeChanged="DataLayout_SizeChanged"><Grid.RowDefinitions><RowDefinition x:Name="TableRow" Height="3*" MinHeight="0"/><RowDefinition x:Name="DataDividerRow" Height="5"/><RowDefinition x:Name="GraphRow" Height="2*" MinHeight="0"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="TableColumn" Width="*"/><ColumnDefinition x:Name="DataDividerColumn" Width="0"/><ColumnDefinition x:Name="GraphColumn" Width="0"/><ColumnDefinition x:Name="WorkspaceSlackColumn" Width="0"/></Grid.ColumnDefinitions>
     <Grid x:Name="TableViewport" ClipToBounds="True" SizeChanged="TableViewport_SizeChanged"><Grid x:Name="TablePanel"><Grid.RowDefinitions><RowDefinition x:Name="AxisTitleRow" Height="21"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="AxisLabelColumn" Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource AxisBandBrush}"/>
      <Grid Grid.Column="1" x:Name="XAxisBand"><Grid.ColumnDefinitions><ColumnDefinition x:Name="AxisHeaderSpacer" Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="AxisScrollbarSpacer" Width="0"/></Grid.ColumnDefinitions><Border x:Name="XAxisChrome" Grid.ColumnSpan="2" Background="{DynamicResource AxisBandBrush}" IsHitTestVisible="False"/><Grid Grid.Column="1" x:Name="XAxisTitleArea" HorizontalAlignment="Left" Width="0" ClipToBounds="True"><TextBlock x:Name="XAxisText" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0"/></Grid></Grid>
      <Border Grid.Row="1" x:Name="YAxisBand" Background="{DynamicResource AxisBandBrush}"><Grid x:Name="YAxisTitleArea" VerticalAlignment="Top" Height="0" ClipToBounds="True"><TextBlock x:Name="YAxisText" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2"><TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform></TextBlock></Grid></Border>
     <DataGrid Grid.Row="1" Grid.Column="1" x:Name="MapGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Extended" SelectionUnit="Cell" HeadersVisibility="All" RowHeaderWidth="64" RowHeight="25" ColumnHeaderHeight="26" FontSize="12" EnableColumnVirtualization="True" EnableRowVirtualization="True" PreparingCellForEdit="Grid_PreparingEdit" CellEditEnding="Grid_EditEnding" SelectedCellsChanged="Grid_SelectionChanged" LoadingRow="Grid_LoadingRow" ScrollViewer.ScrollChanged="Grid_ScrollChanged" SizeChanged="Grid_SizeChanged" LayoutUpdated="Grid_LayoutUpdated">
      <DataGrid.RowHeaderStyle><Style TargetType="DataGridRowHeader" BasedOn="{StaticResource {x:Type DataGridRowHeader}}"><Setter Property="Padding" Value="2,2"/><Setter Property="Background" Value="{DynamicResource AxisBandBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AxisBorderBrush}"/><Setter Property="BorderThickness" Value="0,0,2,1"/><Style.Triggers><DataTrigger Binding="{Binding Path=(local:EditorWorkspace.IsAxisSelected), RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Background" Value="{DynamicResource CellSelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></DataTrigger></Style.Triggers></Style></DataGrid.RowHeaderStyle>
      <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="4,2"/><Setter Property="Background" Value="{DynamicResource AxisBandBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AxisBorderBrush}"/><Setter Property="BorderThickness" Value="0,0,1,2"/><Style.Triggers><DataTrigger Binding="{Binding Path=Column.(local:EditorWorkspace.IsAxisSelected), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="{DynamicResource CellSelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></DataTrigger></Style.Triggers></Style></DataGrid.ColumnHeaderStyle>
     </DataGrid>
      <Thumb x:Name="RowLabelDivider" Grid.Row="1" Grid.Column="1" Width="8" HorizontalAlignment="Left"
             Visibility="Collapsed" Focusable="False" Cursor="SizeWE" Panel.ZIndex="3"
             AutomationProperties.Name="Resize row labels" ToolTip="Drag to resize row labels. Double-click to fit the text."
             PreviewMouseLeftButtonDown="RowLabelDivider_MouseDown" DragStarted="RowLabelDivider_Started"
             DragDelta="RowLabelDivider_Delta" DragCompleted="RowLabelDivider_Completed">
       <Thumb.Template>
        <ControlTemplate TargetType="Thumb">
         <Grid Background="Transparent">
          <Border x:Name="Grip" Width="2" HorizontalAlignment="Center" Background="{DynamicResource AxisBorderBrush}"/>
         </Grid>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource AmberBrush}"/></Trigger>
          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource AmberBrush}"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </Thumb.Template>
      </Thumb>
      <Border x:Name="AxisFrame" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="2" BorderBrush="{DynamicResource AxisBorderBrush}" BorderThickness="1" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
     </Grid></Grid>
     <GridSplitter x:Name="DataSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="{DynamicResource LineBrush}" ToolTip="Drag to resize the table and graph" DragStarted="DataSplitter_Started" DragCompleted="LayoutSplitter_Completed">
      <GridSplitter.Style><Style TargetType="GridSplitter"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers><Setter Property="Opacity" Value="0.6"/></Style></GridSplitter.Style>
     </GridSplitter>
     <Grid x:Name="GraphPanel" Grid.Row="2" Focusable="True" Background="{DynamicResource PanelBrush}"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="6,2"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="FitViewButton" Content="Fit view" ToolTip="Fit view" Click="ResetView_Click" Padding="6,1" MinHeight="23"/><Button Content="↗" Click="PopGraph_Click" ToolTip="Pop out graph" Padding="5,1" MinHeight="23"/></StackPanel><TextBlock x:Name="GraphTitle" Text="Curve / surface" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel><local:TuningGraph Grid.Row="1" x:Name="Graph" Margin="4"/></Grid>
     <ScrollViewer x:Name="ScalarPanel" Grid.RowSpan="3" Grid.ColumnSpan="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
      <StackPanel x:Name="ScalarContent" Margin="6,4" VerticalAlignment="Top">
        <WrapPanel>
         <TextBox x:Name="ScalarInput" MinWidth="80" MaxWidth="160" FontSize="13" Padding="6,3" TextChanged="ScalarInput_Changed" GotKeyboardFocus="ScalarInput_Focused" PreviewKeyDown="ScalarInput_KeyDown" AutomationProperties.Name="Map value"/>
         <ComboBox x:Name="ScalarChoice" MinWidth="100" MaxWidth="180" FontSize="13" MinHeight="24" SelectionChanged="ScalarChoice_Changed" Visibility="Collapsed" AutomationProperties.Name="Map state"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="140"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
         <TextBlock x:Name="ScalarUnits" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="180" Margin="6,0,0,0"/>
         <TextBlock x:Name="ScalarDifference" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
         <StackPanel x:Name="ScalarActions" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed"><Button x:Name="ScalarApply" Content="Apply" Click="ScalarApply_Click" IsEnabled="False" Style="{DynamicResource PrimaryButton}" FontSize="11" MinHeight="23" Padding="7,1" ToolTip="Apply this value · Enter"/><Button x:Name="ScalarCancel" Content="Cancel" Click="ScalarCancel_Click" IsEnabled="False" FontSize="11" MinHeight="23" Padding="7,1" ToolTip="Discard the typed value · Escape"/></StackPanel>
        </WrapPanel>
        <TextBlock x:Name="ScalarError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
        <WrapPanel Margin="0,5,0,0"><TextBlock x:Name="ScalarReference" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="6,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="110"/><Button x:Name="ScalarReset" Content="↶" Click="Reset_Click" FontSize="13" MinHeight="23" Padding="6,1" ToolTip="Reset this value to the selected baseline" AutomationProperties.Name="Reset to baseline"/></WrapPanel>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <Border x:Name="NoMapPanel" Grid.RowSpan="3" Panel.ZIndex="5" Background="{DynamicResource ShellBrush}">
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="24">
      <TextBlock x:Name="NoMapTitle" Text="Open a ROM to begin" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock x:Name="NoMapText" Text="Choose a supported ROM to browse and edit its maps." Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,20"/>
      <Button x:Name="NoMapAction" Content="Open ROM…" Click="NoMapAction_Click" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Center" Padding="18,8"/>
     </StackPanel>
    </Border>
   </Grid>
   <Border x:Name="DetailsPanel" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" Padding="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock x:Name="MapTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="HelpUnitsText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBlock x:Name="HelpAxesText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock x:Name="HelpText" Text="Choose a map." TextWrapping="Wrap" Margin="0,12"/>
      <TextBlock x:Name="GuideTopic" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10">
       <Hyperlink x:Name="GuideLink" Foreground="{DynamicResource AmberBrush}" Click="GuideLink_Click"><Run x:Name="GuideLinkText"/></Hyperlink>
      </TextBlock>
      <Expander Header="Storage details"><TextBlock x:Name="StorageText" TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <GridSplitter x:Name="ChangesSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource ShellBrush}" Visibility="Collapsed"/>
   <Border x:Name="ChangesPanel" Grid.Column="4" Background="{DynamicResource PanelBrush}" Padding="8" Visibility="Collapsed"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Changed maps" FontWeight="SemiBold" Margin="0,0,0,8"/><ListBox x:Name="ChangesList" DisplayMemberPath="Name" SelectionChanged="Changes_Selected"/></DockPanel></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="2,3,2,0"><TextBlock x:Name="ExportIntegrityText" DockPanel.Dock="Right" Text="Checksum ✓ on save" ToolTip="Every export applies the ROM's integrity policy: checksum correction when supported, otherwise mandatory native code and marker validation. Invalid Gen 2 code is rejected without repair." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="10,0,0,0"/><TextBlock x:Name="ValueUnitsText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="6,0" MaxWidth="120" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CellText" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,0"/><TextBlock x:Name="FileText" DockPanel.Dock="Left" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" MaxWidth="180" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="EditorStatus" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="Open a ROM to begin" TextTrimming="CharacterEllipsis"/></DockPanel>
 </Grid>
</UserControl>
